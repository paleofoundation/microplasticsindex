{
  "name": "microplasticsindex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Source-traceable microplastics literature, using the retained HMI templates.",
  "homepage": "https://microplasticsindex.com",
  "repository": "https://github.com/paleofoundation/microplasticsindex",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/check.mjs",
    "check": "node scripts/check.mjs",
    "build:theme": "sass --silence-deprecation=import templates/theme.scss assets/theme.css --style=compressed --no-source-map",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": { "node": ">=22" },
  "devDependencies": { "sass": "1.97.2" }
}
